{
  "name": "simply-a-screenshot-app",
  "productName": "Simply a screenshot app",
  "version": "1.0.0",
  "description": "A macOS desktop editor for designing, localizing and exporting App Store and Google Play screenshots.",
  "author": "Paolo AC <hola@mirloapps.es>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paoloacx/simply-a-screenshot-app.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "build:mac": "next build && electron-builder --mac dmg --arm64 --config electron-builder.config.js",
    "postinstall": "patch-package",
    "clean": "rm -rf .next tsconfig.tsbuildinfo ../Instalador/mac-arm64 ../Instalador/*.blockmap ../Instalador/*.yml"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "next": "16.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "sharp": "0.35.5",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
